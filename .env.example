# Copy to .env (loaded automatically) or set these in your MCP client's "env" block.
# Relative paths are resolved against this package's directory. "~/" is supported.

# --- OAuth2 (user accounts) -------------------------------------------------
# OAuth client downloaded from Google Cloud Console (Desktop app type).
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Tokens for the "default" profile (created by `npm run auth`).
GOOGLE_TOKENS_PATH=./tokens.json
# Optional: address of the default profile, used as the From header.
# GOOGLE_OAUTH_EMAIL=you@example.com

# Optional second account exposed as profile "personal"
# (created by `npm run auth -- --profile personal`).
# GOOGLE_PERSONAL_TOKENS_PATH=./tokens_personal.json
# GOOGLE_PERSONAL_EMAIL=you@gmail.com
# GOOGLE_PERSONAL_CREDENTIALS_PATH=./credentials.json

# Optional: any number of extra profiles. Tools accept the profile name or its email in "account".
# GOOGLE_PROFILES_JSON={"work":{"tokensPath":"./tokens_work.json","email":"me@example.com"},"side":{"tokensPath":"./tokens_side.json","credentialsPath":"./credentials_side.json"}}

# Profile used by gmail_personal_* / gdrive_personal_* when "account" is omitted
# (default: "personal" if configured, otherwise "default").
# GOOGLE_DEFAULT_PROFILE=personal

# Port for the local OAuth callback used by `npm run auth`.
# GOOGLE_OAUTH_PORT=3005

# --- Service account + domain-wide delegation (Google Workspace) -----------
# When this file exists, Workspace tools use it; otherwise they fall back to the "default" OAuth profile.
GOOGLE_SERVICE_ACCOUNT_PATH=./service_account.json
# Mailbox impersonated when a tool call does not pass impersonateUser/userEmail.
# GOOGLE_IMPERSONATED_USER=assistant@example.com
# Google Groups cannot be impersonated: map group addresses to a real member mailbox.
# GOOGLE_GROUP_SUBJECT_MAP={"sales@example.com":"assistant@example.com"}

# --- Guards (optional) --------------------------------------------------------
# Restrict impersonation subjects and Drive sharing targets to these domains.
# GOOGLE_ALLOWED_INTERNAL_DOMAINS=example.com,example.org
# Domains that new Drive files/folders (outside Shared Drives) are auto-shared with as writer.
# GOOGLE_AUTO_SHARE_DOMAINS=example.com

# --- Google Cloud DNS -----------------------------------------------------------
# Key file for Cloud DNS (falls back to the service account, OAuth tokens, then ADC).
# GCP_DNS_KEY_FILE=./service_account_dns.json
# GCP_DNS_PROJECT=my-gcp-project
# GCP_DNS_MANAGED_ZONE=example-com
